function obterConteudoMatrizEnemPedagogicaCNV01430_() {
  let ultimaCompetencia = '';
  let ultimaDescricao = '';
  return MATRIZ_ENEM_PEDAGOGICA_CN_V01430_.map(function(item) {
    if (item.referenciaPiloto) {
      const piloto = Object.assign({}, PILOTO_MATRIZ_H24_V01420_);
      ultimaCompetencia = piloto.competencia;
      ultimaDescricao = piloto.descricao_competencia;
      return piloto;
    }
    const copia = Object.assign({}, item);
    if (copia.competencia !== ultimaCompetencia) {
      ultimaCompetencia = copia.competencia;
      ultimaDescricao = copia.descricao_competencia;
    } else {
      copia.descricao_competencia = ultimaDescricao;
    }
    return copia;
  });
}

function auditarConteudoMatrizEnemPedagogicaCNV01430() {
  const registros = obterConteudoMatrizEnemPedagogicaCNV01430_();
  validarConteudoMatrizEnemPedagogicaCNV01430_(registros);
  return registros.map(function(registro) {
    const copia = {};
    [
      'competencia', 'descricao_competencia', 'habilidade', 'descricao_habilidade',
      'verbo_central', 'operacao_cognitiva', 'interpretacao_pedagogica',
      'expectativa_aprendizagem', 'evidencias_de_dominio', 'dificuldades_frequentes',
      'perguntas_diagnosticas', 'antes_da_questao', 'durante_a_questao',
      'depois_da_questao', 'retomada', 'mediacao', 'consolidacao'
    ].forEach(function(campo) { copia[campo] = registro[campo]; });
    return copia;
  });
}

function carregarRascunhosMatrizEnemPedagogicaCNV01430() {
  const ss = obterSpreadsheetOfflineSyncV070_();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const registros = obterConteudoMatrizEnemPedagogicaCNV01430_();
    validarConteudoMatrizEnemPedagogicaCNV01430_(registros);
    const aba = ss.getSheetByName(MATRIZ_ENEM_PEDAGOGICA_V01320.ABA);
    if (!aba) {
      throw new Error('Aba MATRIZ_ENEM_PEDAGOGICA não encontrada; carga interrompida.');
    }
    const headers = aba.getRange(1, 1, 1, aba.getLastColumn()).getDisplayValues()[0]
      .map(function(header) { return String(header || '').trim(); });
    validarSchemaMatrizCNV01430_(headers);
    const idx = headers.reduce(function(mapa, header, indice) {
      mapa[header] = indice; return mapa;
    }, {});
    const totalLinhasOriginais = Math.max(aba.getLastRow() - 1, 0);
    const intervaloDados = totalLinhasOriginais
      ? aba.getRange(2, 1, totalLinhasOriginais, headers.length)
      : null;
    const linhas = intervaloDados ? intervaloDados.getValues() : [];
    const formulas = intervaloDados ? intervaloDados.getFormulas() : [];
    const chaves = {};
    linhas.forEach(function(linha, indice) {
      const area = textoMatrizCNV01430_(linha[idx.area]).toUpperCase();
      const competencia = textoMatrizCNV01430_(linha[idx.competencia]).toUpperCase();
      const habilidade = textoMatrizCNV01430_(linha[idx.habilidade]).toUpperCase();
      if (!area && !competencia && !habilidade) return;
      const chave = [area, competencia, habilidade].join('|');
      if (chaves[chave] !== undefined) {
        throw new Error('Chave duplicada em MATRIZ_ENEM_PEDAGOGICA: ' + chave);
      }
      chaves[chave] = indice;
    });
    const indiceH24 = chaves['CN|C7|H24'];
    if (indiceH24 === undefined) {
      throw new Error('Registro aprovado CN|C7|H24 não encontrado; carga interrompida.');
    }
    validarH24PreservadaCNV01430_(linhas[indiceH24], idx);

    const alvos = registros.filter(function(registro) {
      return registro.habilidade !== 'H24';
    });
    const chavesAlvo = new Set(alvos.map(function(registro) {
      return ['CN', registro.competencia, registro.habilidade].join('|');
    }));
    const indicesNaoAlvo = linhas.map(function(_, indice) { return indice; })
      .filter(function(indice) {
        const linha = linhas[indice];
        const chave = [linha[idx.area], linha[idx.competencia], linha[idx.habilidade]]
          .map(function(valor) { return textoMatrizCNV01430_(valor).toUpperCase(); })
          .join('|');
        return !chavesAlvo.has(chave);
      });
    const snapshotNaoAlvoAntes = fingerprintLinhasMatrizCNV01430_(
      linhas, formulas, indicesNaoAlvo);
    const quantidadeOutrasAreasAntes = contarLinhasOutrasAreasCNV01430_(linhas, idx);
    const linhasSimuladas = linhas.map(function(linha) { return linha.slice(); });
    const atualizacoesExistentes = [];
    const novasLinhas = [];

    alvos.forEach(function(registro) {
        const chave = ['CN', registro.competencia, registro.habilidade].join('|');
        let linha = new Array(headers.length).fill('');
        if (chaves[chave] === undefined) {
          headers.forEach(function(header, coluna) {
            if (Object.prototype.hasOwnProperty.call(registro, header)) {
              linha[coluna] = registro[header];
            }
          });
          novasLinhas.push(linha);
          linhasSimuladas.push(linha.slice());
        } else {
          const indiceExistente = chaves[chave];
          linha = linhas[indiceExistente].slice();
          headers.forEach(function(header, coluna) {
            if (Object.prototype.hasOwnProperty.call(registro, header)) {
              linha[coluna] = registro[header];
            }
          });
          linhasSimuladas[indiceExistente] = linha.slice();
          atualizacoesExistentes.push({ numeroLinha: indiceExistente + 2, valores: linha });
        }
    });

    // Toda validação que pode ser feita em memória ocorre antes da primeira escrita.
    validarLinhasPosCargaCNV01430_(linhasSimuladas, idx, registros);

    atualizacoesExistentes.forEach(function(atualizacao) {
      aba.getRange(atualizacao.numeroLinha, 1, 1, headers.length)
        .setValues([atualizacao.valores]);
    });
    if (novasLinhas.length) {
      aba.getRange(aba.getLastRow() + 1, 1, novasLinhas.length, headers.length)
        .setValues(novasLinhas);
    }

    const totalLinhasDepois = Math.max(aba.getLastRow() - 1, 0);
    const intervaloDepois = aba.getRange(2, 1, totalLinhasDepois, headers.length);
    const relidas = intervaloDepois.getValues();
    const formulasDepois = intervaloDepois.getFormulas();
    validarLinhasPosCargaCNV01430_(relidas, idx, registros);
    validarH24PreservadaCNV01430_(relidas[indiceH24], idx);
    const snapshotNaoAlvoDepois = fingerprintLinhasMatrizCNV01430_(
      relidas, formulasDepois, indicesNaoAlvo);
    if (snapshotNaoAlvoDepois !== snapshotNaoAlvoAntes) {
      throw new Error('Linhas não alvo foram alteradas durante a carga.');
    }
    if (contarLinhasOutrasAreasCNV01430_(relidas, idx) !== quantidadeOutrasAreasAntes) {
      throw new Error('A quantidade de linhas de outras áreas foi alterada durante a carga.');
    }
    const resumo = resumirMatrizCNV01430_(relidas, idx);
    Logger.log(JSON.stringify(resumo));
    return resumo;
  } finally {
    lock.releaseLock();
  }
}

